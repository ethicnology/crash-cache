# Copy to .env in this directory; never commit the populated copy.
# Generate four DIFFERENT hexadecimal passwords, e.g. openssl rand -hex 32.
# The application password is interpolated into a URI: use the generated hex value.
POSTGRES_PASSWORD=
CRASH_CACHE_DB_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_READONLY_PASSWORD=

# Absolute existing paths. JSON credentials, if needed, stay in the private copy.
SYMBOLS_DIRECTORY=
SYMBOLICATOR_SOURCES_FILE=

# Loopback only; adjust ports to avoid existing services.
CRASH_CACHE_LAB_PORT=3000
METABASE_LAB_PORT=3001
METABASE_PROXY_PORT=3002
# Browser-facing origin; update if changing proxy port or using a tunnel/domain.
METABASE_SITE_URL=http://localhost:3002
